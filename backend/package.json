{
  "name": "@marketplace/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:arch": "depcruise --validate .dependency-cruiser.cjs src/",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/migrations/run.ts",
    "test:integration": "vitest run --config vitest.integration.ts",
    "test:perf:smoke": "k6 run tests/performance/smoke.js",
    "test:perf:stress": "k6 run tests/performance/stress.js",
    "verify": "npm run build && npm run lint:arch && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1084.0",
    "@aws-sdk/s3-request-presigner": "^3.1084.0",
    "@hono/node-server": "^1.14.0",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-validator": "^0.4.0",
    "@supabase/supabase-js": "^2.110.7",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.4.2",
    "hono": "^4.7.0",
    "jose": "^6.0.0",
    "nodemailer": "^6.10.0",
    "pg": "^8.13.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.0",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^9.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.9"
  }
}
